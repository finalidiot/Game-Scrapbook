<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GameScrapbook</AssemblyName>
    <RootNamespace>GameScrapbook.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/GameScrapbook.ico</ApplicationIcon>
    <Version>0.1.7</Version>
    <Description>Snip game information and drag it onto a persistent second-screen scrapbook.</Description>
    <Company>Game Scrapbook</Company>
    <Product>Game Scrapbook</Product>
    <PublishTrimmed>false</PublishTrimmed>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../GameScrapbook.Core/GameScrapbook.Core.csproj" />
    <Resource Include="Assets/GameScrapbook.ico" />
  </ItemGroup>
</Project>
