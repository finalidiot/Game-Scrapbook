<Window x:Class="GameScrapbook.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Scrapbook" Icon="Assets/GameScrapbook.ico" Width="1040" Height="780" MinWidth="650" MinHeight="440"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="15"
        WindowStartupLocation="Manual" PreviewKeyDown="Window_KeyDown"
        Loaded="Window_Loaded" Closing="Window_Closing" LocationChanged="Window_PlacementChanged"
        SizeChanged="Window_SizeChanged" StateChanged="Window_PlacementChanged">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,18">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <Button Content="Settings" Click="Settings_Click" Margin="0,0,8,0" ToolTip="Colours, shortcut, mouse return and window options" />
          <Button Content="Help" Click="Help_Click" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource AccentBrush}" Margin="0,0,13,0">
            <Canvas Width="24" Height="24">
              <Rectangle Width="15" Height="17" Canvas.Left="2" Canvas.Top="5" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentTextBrush}" Opacity="0.6" />
              <Rectangle Width="15" Height="17" Canvas.Left="7" Canvas.Top="1" RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentTextBrush}" />
              <Line X1="10" Y1="7" X2="19" Y2="7" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
              <Line X1="10" Y1="11" X2="17" Y2="11" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" />
            </Canvas>
          </Border>
          <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold"><Run Text="Game Scrapbook" /><Run Text="  v0.1.8" FontSize="13" Foreground="{DynamicResource MutedBrush}" /></TextBlock>
            <TextBlock Text="Keep your game notes in view." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Grid.Row="1" Padding="20,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel>
      <WrapPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,8">
          <Button x:Name="SnipButton" Content="Snip" Click="Snip_Click" IsEnabled="False" MinWidth="86" Margin="0,0,12,0"
                  Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}" FontWeight="SemiBold"
                  ToolTip="Start a snip in 3 seconds. Move the mouse to the screen you want." />
          <Border Background="{DynamicResource ControlBrush}" CornerRadius="5" Padding="9,5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
            <TextBlock x:Name="ShortcutLabel" Text="Ctrl + Alt + S" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" Margin="0,0,6,0" ToolTip="Undo · Ctrl+Z" />
          <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" Margin="0,0,14,0" ToolTip="Delete selected snip" />
          <Button x:Name="ArchiveSelectedButton" Content="Archive selected" Click="ArchiveSelected_Click" Margin="0,0,14,0" ToolTip="Keep the selected snip in Archive and clear it from the board" />
          <Button Content="−" Click="ZoomOut_Click" Padding="12,6" ToolTip="Zoom out" />
          <Button x:Name="ZoomButton" Content="100%" Click="ResetZoom_Click" MinWidth="66" Margin="4,0" Padding="6,6" ToolTip="Reset to 100%" />
          <Button Content="+" Click="ZoomIn_Click" Padding="12,6" ToolTip="Zoom in" />
        </StackPanel>
        <Button x:Name="ArchiveButton" Content="Archive (0)" Click="Archive_Click" Margin="14,0,0,8"
                ToolTip="Browse archived snips and restore them to the scrapbook" />
        <CheckBox x:Name="SnapEdgesCheckBox" Content="Snap edges" IsChecked="True"
                  Checked="SnapEdges_Changed" Unchecked="SnapEdges_Changed" Margin="14,0,14,8" VerticalAlignment="Center"
                  ToolTip="Snap nearby image edges while moving or placing snips. Hold Shift while dragging to move freely." />
        <Button x:Name="MagnetiseButton" Content="Magnetise" Click="Magnetise_Click" Margin="0,0,8,8"
                ToolTip="Bring all board snips together into a compact arrangement. Ctrl+Z restores their previous positions." />
        <Button x:Name="ExportButton" Content="Export image" Click="Export_Click" Margin="0,0,0,8"
                ToolTip="Save all board snips together as a JPG or PNG, without buttons or controls" />
      </WrapPanel>
      <TextBlock x:Name="ShortcutStatusLabel" Text="Checking capture shortcut…" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" FontSize="14" Margin="0,2,0,0" />
      <Border x:Name="CaptureNotice" Visibility="Collapsed" Background="{DynamicResource NoticeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="11,8" Margin="0,10,0,0">
        <TextBlock x:Name="CaptureNoticeText" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
      </Border>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" x:Name="BoardArea" Margin="14">
      <Border x:Name="BoardFrame" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource BoardBrush}" ClipToBounds="True">
        <Grid Margin="1">
          <ScrollViewer x:Name="BoardScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        CanContentScroll="False" PreviewMouseWheel="Board_MouseWheel" PanningMode="Both">
            <Canvas x:Name="BoardCanvas" Width="2400" Height="1600" Focusable="True"
                    MouseLeftButtonDown="Canvas_MouseDown" ClipToBounds="False">
              <Canvas.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
                  <DrawingBrush.Drawing>
                    <DrawingGroup>
                      <GeometryDrawing Brush="{DynamicResource BoardBrush}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24" /></GeometryDrawing.Geometry></GeometryDrawing>
                      <GeometryDrawing Brush="{DynamicResource GridDotBrush}"><GeometryDrawing.Geometry><EllipseGeometry Center="12,12" RadiusX="0.8" RadiusY="0.8" /></GeometryDrawing.Geometry></GeometryDrawing>
                    </DrawingGroup>
                  </DrawingBrush.Drawing>
                </DrawingBrush>
              </Canvas.Background>
              <Canvas.LayoutTransform><ScaleTransform x:Name="BoardScale" ScaleX="1" ScaleY="1" /></Canvas.LayoutTransform>
            </Canvas>
          </ScrollViewer>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" MaxWidth="440" Margin="22">
            <Border Width="74" Height="65" CornerRadius="12" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Background="{DynamicResource PanelBrush}" HorizontalAlignment="Center" Margin="0,0,0,22">
              <TextBlock Text="+" FontSize="40" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
            </Border>
            <TextBlock x:Name="EmptyTitle" Text="Drop your first snip here" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock x:Name="EmptyArchiveHint" Text="Open Archive to view or restore your saved snips." Visibility="Collapsed"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" TextAlignment="Center" Margin="0,10,0,0" />
            <TextBlock x:Name="EmptyInstructions" Text="Open a recipe or quest in your game.&#10;Press Ctrl + Alt + S, select it, then drag it here."
                       Foreground="{DynamicResource TextBrush}" FontSize="15" LineHeight="25" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock Text="Drop it. Get straight back to your game." Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,0" />
          </StackPanel>
          <Border x:Name="DropHint" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top"
                  Margin="15" Background="{DynamicResource AccentBrush}" CornerRadius="7" Padding="18,10">
            <TextBlock Text="Release to pin your snip here" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Padding="21,0,21,14">
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="SnipCount" DockPanel.Dock="Right" Text="0 snips" Foreground="{DynamicResource TextBrush}" Margin="16,0,0,0" />
        <StackPanel>
          <TextBlock x:Name="StatusLabel" Text="Ready · Keep this window on your second screen." Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
          <TextBlock Text="Drag to snap  ·  Shift to move freely  ·  Magnetise to bring snips together  ·  Export image to save JPG or PNG" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
